{
  "name": "moible-cra",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --tunnel ngrok",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "pc": "node web-pc/server.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "postinstall": "node -e \"const fs=require('fs'),p='node_modules/ws/index.js';if(fs.existsSync(p)){let c=fs.readFileSync(p,'utf8');if(!c.includes('WebSocket.WebSocket'))fs.writeFileSync(p,c.replace('module.exports = WebSocket;','WebSocket.WebSocket = WebSocket;\\nmodule.exports = WebSocket;'))}\""
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-vector-icons/material-icons": "^13.1.0",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.11",
    "@supabase/supabase-js": "^2.105.3",
    "axios": "^1.15.1",
    "base64-arraybuffer": "^1.0.2",
    "expo": "^58.0.0",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-image-picker": "~58.0.10",
    "expo-location": "~58.0.20",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "ngrok": "^5.0.0-beta.2",
    "react": "19.3.0",
    "react-hook-form": "^7.73.1",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-maps": "1.29.11",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@playwright/test": "^1.65.0",
